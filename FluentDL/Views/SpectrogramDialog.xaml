<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentDL.Views.SpectrogramDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:spek="using:Spek.Net.WinUI">
    <ContentDialog
        x:Name="Dialog"
        Title="Spectrogram"
        AutomationProperties.AutomationId="SpectrogramDialog"
        CloseButtonText="Close"
        Closing="Dialog_Closing"
        DefaultButton="None"
        IsPrimaryButtonEnabled="False"
        Opened="Dialog_Opened"
        PrimaryButtonClick="SaveImage_Click"
        PrimaryButtonText="Save image"
        SecondaryButtonClick="ResetZoom_Click"
        SecondaryButtonText="Reset zoom">
        <ContentDialog.PrimaryButtonStyle>
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="AutomationProperties.AutomationId" Value="SpectrogramSave" />
            </Style>
        </ContentDialog.PrimaryButtonStyle>
        <ContentDialog.SecondaryButtonStyle>
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="AutomationProperties.AutomationId" Value="SpectrogramResetZoom" />
            </Style>
        </ContentDialog.SecondaryButtonStyle>
        <ContentDialog.CloseButtonStyle>
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="AutomationProperties.AutomationId" Value="SpectrogramClose" />
            </Style>
        </ContentDialog.CloseButtonStyle>
        <ContentDialog.Resources>
            <x:Double x:Key="ContentDialogMaxWidth">1500</x:Double>
            <x:Double x:Key="ContentDialogMaxHeight">1000</x:Double>
        </ContentDialog.Resources>
        <Grid x:Name="DialogBody" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <CommandBar DefaultLabelPosition="Right">
                <AppBarButton x:Name="PaletteButton" AutomationProperties.AutomationId="SpectrogramPalette" Label="Spectrum" ToolTipService.ToolTip="Palette (P or Shift+P)">
                    <AppBarButton.Flyout><MenuFlyout x:Name="PaletteMenu" Opening="OptionsMenu_Opening" /></AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Name="WindowButton" AutomationProperties.AutomationId="SpectrogramWindow" Label="Hann" ToolTipService.ToolTip="Window function (F or Shift+F)">
                    <AppBarButton.Flyout><MenuFlyout x:Name="WindowMenu" Opening="OptionsMenu_Opening" /></AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Name="FftButton" AutomationProperties.AutomationId="SpectrogramFft" Label="2048 samples" ToolTipService.ToolTip="FFT size (W or Shift+W)">
                    <AppBarButton.Flyout><MenuFlyout x:Name="FftMenu" Opening="OptionsMenu_Opening" /></AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Name="ChannelButton" AutomationProperties.AutomationId="SpectrogramChannel" Label="Channel" ToolTipService.ToolTip="Audio channel (C or Shift+C)">
                    <AppBarButton.Flyout><MenuFlyout x:Name="ChannelMenu" Opening="OptionsMenu_Opening" /></AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Name="StreamButton" AutomationProperties.AutomationId="SpectrogramStream" Label="Stream" ToolTipService.ToolTip="Audio stream (S or Shift+S)" Visibility="Collapsed">
                    <AppBarButton.Flyout><MenuFlyout x:Name="StreamMenu" Opening="OptionsMenu_Opening" /></AppBarButton.Flyout>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton AutomationProperties.AutomationId="SpectrogramOptions" Label="Inspection options">
                    <AppBarButton.Flyout>
                        <Flyout>
                            <Grid Width="480" ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <NumberBox x:Name="LowerBox" AutomationProperties.AutomationId="SpectrogramLowerDb" Header="Lower limit (dB)" Minimum="-140" Maximum="-1" SpinButtonPlacementMode="Compact" ValueChanged="Range_Changed" />
                                <NumberBox x:Name="UpperBox" Grid.Column="1" AutomationProperties.AutomationId="SpectrogramUpperDb" Header="Upper limit (dB)" Minimum="-139" Maximum="0" SpinButtonPlacementMode="Compact" ValueChanged="Range_Changed" />
                                <ComboBox x:Name="ReferencesBox" Grid.Column="2" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="SpectrogramReferences" Header="Reference lines" SelectionChanged="References_Changed">
                                    <ComboBoxItem Content="None" /><ComboBoxItem Content="MP3 - LAME defaults" />
                                </ComboBox>
                                <CheckBox x:Name="ProfileToggle" Grid.Row="1" AutomationProperties.AutomationId="SpectrogramShowProfile" Content="Spectrum profile" Checked="Inspection_Changed" Unchecked="Inspection_Changed" />
                                <CheckBox x:Name="CutoffToggle" Grid.Row="1" Grid.Column="1" AutomationProperties.AutomationId="SpectrogramShowCutoff" Content="Cutoff marker" Checked="Inspection_Changed" Unchecked="Inspection_Changed" />
                                <Button Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" AutomationProperties.AutomationId="SpectrogramClearSelection" Content="Whole file" Click="ClearSelection_Click" />
                            </Grid>
                        </Flyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
            </CommandBar>
            <spek:SpekView x:Name="Spek" Grid.Row="1" BrandName="Spek.NET" PreviewKeyDown="Spek_PreviewKeyDown" ShowFullPath="False" ShowDetailedDescription="True" />
            <spek:SpectrumProfileView x:Name="Profile" Grid.Row="2" Height="160" Visibility="Collapsed" />

            <StackPanel Grid.Row="3" Spacing="4">
                <TextBlock AutomationProperties.AutomationId="SpectrogramReadout" MinHeight="16" Style="{ThemeResource CaptionTextBlockStyle}" Text="{Binding ReadoutText, ElementName=Spek}" />
                <TextBlock x:Name="InspectionStatus" AutomationProperties.AutomationId="SpectrogramInspectionStatus" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="AnalysisStatus" AutomationProperties.AutomationId="SpectrogramStatus" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" Text="Ctrl+scroll or +/-: frequency zoom. Drag: select a passage. Escape clears the selection, then closes." TextWrapping="Wrap" />
            </StackPanel>
            <InfoBar x:Name="Message" Grid.Row="4" AutomationProperties.AutomationId="SpectrogramMessage" IsOpen="False" IsClosable="True" />
        </Grid>
    </ContentDialog>
</UserControl>
