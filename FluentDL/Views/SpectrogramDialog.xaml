<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentDL.Views.SpectrogramDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:spek="using:Spek.Net.WinUI">
    <ContentDialog
        x:Name="Dialog"
        AutomationProperties.AutomationId="SpectrogramDialog"
        AutomationProperties.Name="Spectrogram"
        CloseButtonText="Close"
        CloseButtonClick="Dialog_CloseButtonClick"
        Closing="Dialog_Closing"
        DefaultButton="None"
        IsPrimaryButtonEnabled="False"
        Opened="Dialog_Opened"
        PrimaryButtonClick="SaveImage_Click"
        PrimaryButtonText="Save image">
        <ContentDialog.PrimaryButtonStyle>
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="AutomationProperties.AutomationId" Value="SpectrogramSave" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
        </ContentDialog.PrimaryButtonStyle>
        <ContentDialog.CloseButtonStyle>
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="AutomationProperties.AutomationId" Value="SpectrogramClose" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
        </ContentDialog.CloseButtonStyle>
        <ContentDialog.Resources>
            <x:Double x:Key="ContentDialogMaxWidth">1500</x:Double>
            <x:Double x:Key="ContentDialogMaxHeight">1000</x:Double>
            <Style x:Key="SpectrogramButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinWidth" Value="88" />
            </Style>
        </ContentDialog.Resources>
        <Grid x:Name="DialogBody" PreviewKeyDown="DialogBody_PreviewKeyDown" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="HeaderBar" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" Text="Spectrogram" />
                <controls:WrapPanel x:Name="HeaderButtons" Grid.Column="1" HorizontalAlignment="Right" HorizontalSpacing="8" VerticalSpacing="8">
                    <Button x:Name="PaletteButton" AutomationProperties.AutomationId="SpectrogramPalette" Content="SoX" Style="{StaticResource SpectrogramButtonStyle}" ToolTipService.ToolTip="Palette (P or Shift+P)">
                        <Button.Flyout><MenuFlyout x:Name="PaletteMenu" Opening="OptionsMenu_Opening" /></Button.Flyout>
                    </Button>
                    <Button x:Name="WindowButton" AutomationProperties.AutomationId="SpectrogramWindow" Content="Hann" Style="{StaticResource SpectrogramButtonStyle}" ToolTipService.ToolTip="Window function (F or Shift+F)">
                        <Button.Flyout><MenuFlyout x:Name="WindowMenu" Opening="OptionsMenu_Opening" /></Button.Flyout>
                    </Button>
                    <Button x:Name="FftButton" AutomationProperties.AutomationId="SpectrogramFft" Content="2048 samples" Style="{StaticResource SpectrogramButtonStyle}" ToolTipService.ToolTip="FFT window size. Fewer samples: finer timing. More samples: finer frequency detail. W or Shift+W.">
                        <Button.Flyout><MenuFlyout x:Name="FftMenu" Opening="OptionsMenu_Opening" /></Button.Flyout>
                    </Button>
                    <Button x:Name="ChannelButton" AutomationProperties.AutomationId="SpectrogramChannel" Content="Channel" Style="{StaticResource SpectrogramButtonStyle}" ToolTipService.ToolTip="Audio channel (C or Shift+C)">
                        <Button.Flyout><MenuFlyout x:Name="ChannelMenu" Opening="OptionsMenu_Opening" /></Button.Flyout>
                    </Button>
                    <Button x:Name="StreamButton" AutomationProperties.AutomationId="SpectrogramStream" Content="Stream" Style="{StaticResource SpectrogramButtonStyle}" ToolTipService.ToolTip="Audio stream (S or Shift+S)" Visibility="Collapsed">
                        <Button.Flyout><MenuFlyout x:Name="StreamMenu" Opening="OptionsMenu_Opening" /></Button.Flyout>
                    </Button>
                    <Button AutomationProperties.AutomationId="SpectrogramOptions" Content="dB limits" Style="{StaticResource SpectrogramButtonStyle}">
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <NumberBox x:Name="LowerBox" Width="176" AutomationProperties.AutomationId="SpectrogramLowerDb" Header="Lower limit (dB)" Minimum="-140" Maximum="-1" SpinButtonPlacementMode="Inline" ValueChanged="Range_Changed" />
                                    <NumberBox x:Name="UpperBox" Width="176" AutomationProperties.AutomationId="SpectrogramUpperDb" Header="Upper limit (dB)" Minimum="-139" Maximum="0" SpinButtonPlacementMode="Inline" ValueChanged="Range_Changed" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </controls:WrapPanel>
            </Grid>
            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="NavigationContent" Spacing="8">
                    <Grid x:Name="InspectionControls" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock AutomationProperties.AutomationId="SpectrogramReferenceLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Reference lines" />
                            <ComboBox x:Name="ReferencesBox" Width="184" AutomationProperties.AutomationId="SpectrogramReferences" AutomationProperties.Name="Reference lines" SelectionChanged="References_Changed">
                                <ComboBoxItem Content="None" /><ComboBoxItem Content="MP3 - LAME defaults" />
                            </ComboBox>
                        </StackPanel>
                        <CheckBox x:Name="ProfileToggle" Grid.Column="1" VerticalAlignment="Bottom" AutomationProperties.AutomationId="SpectrogramShowProfile" Content="Spectrum profile" Checked="Inspection_Changed" Unchecked="Inspection_Changed" />
                        <CheckBox x:Name="CutoffToggle" Grid.Column="2" VerticalAlignment="Bottom" AutomationProperties.AutomationId="SpectrogramShowCutoff" Content="Cutoff marker" Checked="Inspection_Changed" Unchecked="Inspection_Changed" />
                        <Button x:Name="ResetZoomButton" Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Bottom" AutomationProperties.AutomationId="SpectrogramResetZoom" Content="Reset zoom" Style="{StaticResource SpectrogramButtonStyle}" Click="ResetZoom_Click" />
                        <Button x:Name="ClearSelectionButton" Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" AutomationProperties.AutomationId="SpectrogramClearSelection" Content="Clear selection" IsEnabled="False" Visibility="Collapsed" Style="{StaticResource SpectrogramButtonStyle}" ToolTipService.ToolTip="Clear the selected time passage. The profile and cutoff measurement will use the whole track. Zoom is unchanged." Click="ClearSelection_Click" />
                    </Grid>
                    <Grid ColumnSpacing="8" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ZoomReadout" MaxWidth="128" AutomationProperties.AutomationId="SpectrogramZoomReadout" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Zoom: 100%" TextWrapping="Wrap" />
                        <UserControl x:Name="AnalysisStatus" Grid.Column="1" Width="208" MinHeight="16" IsTabStop="False" DataContext="{x:Bind Spek, Mode=OneTime}" AutomationProperties.AutomationId="SpectrogramStatus" AutomationProperties.Name="{Binding ReadoutText}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="64" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                                <TextBlock AutomationProperties.AutomationId="SpectrogramTimeReadout" Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding ReadoutTimeText}" TextAlignment="Right" />
                                <TextBlock Grid.Column="1" AutomationProperties.AutomationId="SpectrogramFrequencyReadout" Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding ReadoutFrequencyText}" TextAlignment="Right" />
                                <TextBlock Grid.Column="2" AutomationProperties.AutomationId="SpectrogramLevelReadout" Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding ReadoutLevelText}" TextAlignment="Right" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding ReadoutLevelText}" />
                            </Grid>
                        </UserControl>
                    </Grid>
                </StackPanel>
                <spek:SpectrogramOverview x:Name="Overview" Grid.Column="1" Height="Auto" VerticalAlignment="Top" Source="{x:Bind Spek, Mode=OneTime}" />
            </Grid>
            <spek:SpekView x:Name="Spek" Grid.Row="2" BrandName="Spek.NET" Palette="Sox" ShowFullPath="False" ShowDetailedDescription="True" />
            <spek:SpectrumProfileView x:Name="Profile" Grid.Row="3" Height="160" Visibility="Collapsed" />

            <StackPanel Grid.Row="4" Spacing="4">
                <TextBlock x:Name="InspectionStatus" AutomationProperties.AutomationId="SpectrogramInspectionStatus" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="SaveStatus" AutomationProperties.AutomationId="SpectrogramSaveStatus" Style="{StaticResource CaptionTextBlockStyle}" Text="Saving image..." Visibility="Collapsed" />
                <TextBlock AutomationProperties.AutomationId="SpectrogramHints" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap">
                    <Run FontWeight="SemiBold" Text="Ctrl+scroll: " /><Run Text="Zoom around the pointer / " />
                    <Run FontWeight="SemiBold" Text="Drag: " /><Run Text="Select a specific passage for the spectrum profile and cutoff / " />
                    <Run FontWeight="SemiBold" Text="Esc: " /><Run Text="Clear spectrum profile selection" />
                </TextBlock>
            </StackPanel>
            <InfoBar x:Name="Message" Grid.Row="5" AutomationProperties.AutomationId="SpectrogramMessage" IsOpen="False" IsClosable="True" />
        </Grid>
    </ContentDialog>
</UserControl>
