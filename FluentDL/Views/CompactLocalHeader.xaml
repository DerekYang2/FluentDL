<UserControl
    x:Class="FluentDL.Views.CompactLocalHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="Header_SizeChanged">
    <UserControl.Resources>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid MinHeight="36" AutomationProperties.AutomationId="CompactLocalHeader">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{x:Bind Columns.TitleWidth}" />
            <ColumnDefinition Width="{x:Bind Columns.AlbumWidth, Mode=OneWay}" />
            <ColumnDefinition Width="{x:Bind Columns.YearWidth, Mode=OneWay}" />
            <ColumnDefinition Width="{x:Bind Columns.DurationWidth}" />
            <ColumnDefinition Width="{x:Bind Columns.FormatWidth}" />
        </Grid.ColumnDefinitions>
        <TextBlock Margin="56,0,0,0" Text="Title" Style="{StaticResource Heading}" TextWrapping="NoWrap" />
        <TextBlock Grid.Column="1" Text="Album" Style="{StaticResource Heading}" Visibility="{x:Bind Columns.AlbumVisibility, Mode=OneWay}" />
        <TextBlock Grid.Column="2" Text="Year" Style="{StaticResource Heading}" Visibility="{x:Bind Columns.YearVisibility, Mode=OneWay}" />
        <TextBlock Grid.Column="3" Margin="0,0,12,0" Text="Duration" Style="{StaticResource Heading}" HorizontalAlignment="Right" />
        <TextBlock Grid.Column="4" Text="Format" Style="{StaticResource Heading}" />
        <Border Grid.ColumnSpan="5" Height="1" VerticalAlignment="Bottom" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
    </Grid>
</UserControl>
