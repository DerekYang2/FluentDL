<UserControl
    x:Class="FluentDL.Views.CompactQueueHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="CompactQueueHeader_SizeChanged">
    <UserControl.Resources>
        <Style
            x:Key="HeadingTextStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid MinHeight="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{x:Bind Columns.ArtworkWidth}" />
            <ColumnDefinition Width="{x:Bind Columns.TitleWidth}" />
            <ColumnDefinition Width="{x:Bind Columns.AlbumWidth, Mode=OneWay}" />
            <ColumnDefinition Width="{x:Bind Columns.YearWidth, Mode=OneWay}" />
            <ColumnDefinition Width="{x:Bind Columns.DurationWidth}" />
            <ColumnDefinition Width="{x:Bind Columns.SourceWidth, Mode=OneWay}" />
            <ColumnDefinition Width="{x:Bind Columns.ActionWidth}" />
        </Grid.ColumnDefinitions>
        <TextBlock
            Grid.Column="1"
            Style="{StaticResource HeadingTextStyle}"
            Text="Title" />
        <TextBlock
            Grid.Column="2"
            Style="{StaticResource HeadingTextStyle}"
            Text="Album"
            Visibility="{x:Bind Columns.AlbumVisibility, Mode=OneWay}" />
        <TextBlock
            Grid.Column="3"
            Style="{StaticResource HeadingTextStyle}"
            Text="Year"
            Visibility="{x:Bind Columns.YearVisibility, Mode=OneWay}" />
        <TextBlock
            Grid.Column="4"
            Margin="0,0,8,0"
            HorizontalAlignment="Right"
            Style="{StaticResource HeadingTextStyle}"
            Text="Duration" />
        <Border
            Grid.ColumnSpan="7"
            Height="1"
            VerticalAlignment="Bottom"
            Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
    </Grid>
</UserControl>
